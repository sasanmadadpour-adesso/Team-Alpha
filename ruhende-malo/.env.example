# Docker Hub account that owns the image
DOCKERHUB_USER=your-dockerhub-user
RUHEND_TAG=latest
RUHEND_PORT=4004
# Required: sign-in code for the public demo (choose something long)
RUHEND_ACCESS_CODE=change-me
# Recommended: keeps sessions valid across restarts (e.g. `openssl rand -hex 32`)
RUHEND_SESSION_SECRET=
# Your public address, shown in the API docs and curl examples (default: the address the page is opened from)
RUHEND_PUBLIC_URL=https://ruhend.your-domain.com
