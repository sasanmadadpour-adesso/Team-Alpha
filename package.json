{
  "name": "vnb-konstruktportal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n frontend,backend -c blue,green \"npm run dev\" \"npm run backend:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "d3-geo": "^3.1.1",
    "react": "latest",
    "react-dom": "latest",
    "topojson-client": "^3.1.0",
    "typescript": "latest",
    "vite": "latest",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
