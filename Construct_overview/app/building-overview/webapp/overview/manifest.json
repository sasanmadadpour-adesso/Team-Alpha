{
  "_version": "1.21.0",
  "sap.app": {
    "id": "vnb.constructs.overview",
    "type": "application",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "vnb.constructs.overview.view.Overview",
      "type": "XML",
      "id": "overviewRoot"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.table": {},
        "sap.f": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vnb.constructs.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "../css/overview.css"
        }
      ]
    }
  }
}
