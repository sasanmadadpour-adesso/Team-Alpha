{
  "_version": "1.77.0",
  "sap.app": {
    "id": "vnb.constructs",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/energy-overview/",
        "type": "OData",
        "settings": { "odataVersion": "4.0", "annotations": [] }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://connected" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {}, "sap.f": {}, "sap.ui.layout": {} }
    },
    "models": {
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "vnb.constructs.i18n.i18n" } },
      "": { "dataSource": "mainService", "preload": true, "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true, "synchronizationMode": "None" } }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "routing": {
      "config": {},
      "routes": [
        { "pattern": ":?query:", "name": "ConstructsList", "target": "ConstructsList" },
        { "pattern": "Constructs({key}):?query:", "name": "ConstructsObjectPage", "target": "ConstructsObjectPage" },
        { "pattern": "Buildings:?query:", "name": "BuildingsList", "target": "BuildingsList" },
        { "pattern": "Buildings({key}):?query:", "name": "BuildingsObjectPage", "target": "BuildingsObjectPage" }
      ],
      "targets": {
        "ConstructsList": {
          "type": "Component", "id": "ConstructsList", "name": "sap.fe.templates.ListReport",
           "options": { "settings": { "contextPath": "/Constructs", "variantManagement": "Page", "views": { "paths": [ { "key": "constructParticipants", "label": "{i18n>constructParticipantsView}", "entitySet": "Constructs", "annotationPath": "com.sap.vocabularies.UI.v1.LineItem" }, { "key": "buildingStructure", "label": "{i18n>buildingStructureView}", "entitySet": "Buildings", "annotationPath": "com.sap.vocabularies.UI.v1.LineItem" } ] }, "navigation": { "Constructs": { "detail": { "route": "ConstructsObjectPage" } }, "Buildings": { "detail": { "route": "BuildingsObjectPage" } } }, "initialLoad": true, "liveMode": false, "content": { "header": { "actions": { "LanguageInfo": { "text": "{i18n>languageHint}", "press": "vnb.constructs.ext.ListActions.showLanguageHint", "visible": true } } } } } }
        },
        "ConstructsObjectPage": {
          "type": "Component", "id": "ConstructsObjectPage", "name": "sap.fe.templates.ObjectPage",
           "options": { "settings": { "contextPath": "/Constructs", "editableHeaderContent": false, "content": { "body": { "sections": { "SharedMeLoTopology": { "template": "vnb.constructs.ext.Topology", "title": "{i18n>topologyTitle}", "position": { "placement": "After", "anchor": "Overview" } }, "EnergyTrend": { "template": "vnb.constructs.ext.EnergyTrend", "title": "{i18n>ENERGY_TREND}", "position": { "placement": "After", "anchor": "Overview" } } } } } } }
        },
        "BuildingsList": {
          "type": "Component", "id": "BuildingsList", "name": "sap.fe.templates.ListReport",
          "options": { "settings": { "contextPath": "/Buildings", "variantManagement": "Page", "initialLoad": true, "navigation": { "Buildings": { "detail": { "route": "BuildingsObjectPage" } } } } }
        },
        "BuildingsObjectPage": {
          "type": "Component", "id": "BuildingsObjectPage", "name": "sap.fe.templates.ObjectPage",
           "options": { "settings": { "contextPath": "/Buildings", "editableHeaderContent": false, "content": { "body": { "sections": { "BuildingSchematic": { "template": "vnb.constructs.ext.BuildingSchematic", "title": "{i18n>schematicTitle}", "position": { "placement": "After", "anchor": "Overview" } }, "EnergyTrend": { "template": "vnb.constructs.ext.EnergyTrend", "title": "{i18n>ENERGY_TREND}", "position": { "placement": "After", "anchor": "Overview" } } } } } } }
        }
      }
    }
  }
}
