{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/house-member-portal-response-1.0.json",
  "title": "House Member Portal Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "range", "brand", "member", "building", "trends"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "range": { "enum": ["24h", "7d", "30d", "90d", "1y"] },
    "brand": { "$ref": "#/$defs/brand" },
    "member": { "$ref": "#/$defs/member" },
    "building": { "$ref": "#/$defs/building" },
    "trends": { "$ref": "#/$defs/trends" }
  },
  "$defs": {
    "address": { "type": "object", "additionalProperties": false, "required": ["street", "postalCode", "city"], "properties": { "street": { "type": "string", "minLength": 1 }, "postalCode": { "type": "string", "minLength": 1 }, "city": { "type": "string", "minLength": 1 } } },
    "brand": { "type": "object", "additionalProperties": false, "required": ["name", "portalName", "logoUrl", "primaryColor", "accentColor"], "properties": { "name": { "type": "string" }, "portalName": { "type": "object", "additionalProperties": false, "required": ["de", "en"], "properties": { "de": { "type": "string" }, "en": { "type": "string" } } }, "logoUrl": { "type": "string", "format": "uri" }, "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } },
    "member": { "type": "object", "additionalProperties": false, "required": ["malo", "melo", "address", "switchoverStatus", "energy"], "properties": { "malo": { "type": "string" }, "melo": { "type": "string" }, "address": { "$ref": "#/$defs/address" }, "switchoverStatus": { "enum": ["COMPLETED", "IN_PROGRESS"] }, "energy": { "$ref": "#/$defs/memberEnergy" } } },
    "memberEnergy": { "type": "object", "additionalProperties": false, "required": ["consumptionKwh", "localEnergyKwh", "gridImportKwh"], "properties": { "consumptionKwh": { "$ref": "#/$defs/nonNegative" }, "localEnergyKwh": { "$ref": "#/$defs/nonNegative" }, "gridImportKwh": { "$ref": "#/$defs/nonNegative" } } },
    "building": { "type": "object", "additionalProperties": false, "required": ["displayId", "address", "productionTypes", "installedCapacityKw", "memberCount", "energy"], "properties": { "displayId": { "type": "string" }, "address": { "$ref": "#/$defs/address" }, "productionTypes": { "type": "array", "items": { "type": "string" } }, "installedCapacityKw": { "$ref": "#/$defs/nonNegative" }, "memberCount": { "$ref": "#/$defs/nonNegative" }, "energy": { "$ref": "#/$defs/buildingEnergy" } } },
    "buildingEnergy": { "type": "object", "additionalProperties": false, "required": ["consumptionKwh", "generationKwh", "localEnergyKwh", "gridImportKwh", "gridExportKwh", "selfSufficiencyPercent"], "properties": { "consumptionKwh": { "$ref": "#/$defs/nonNegative" }, "generationKwh": { "$ref": "#/$defs/nonNegative" }, "localEnergyKwh": { "$ref": "#/$defs/nonNegative" }, "gridImportKwh": { "$ref": "#/$defs/nonNegative" }, "gridExportKwh": { "$ref": "#/$defs/nonNegative" }, "selfSufficiencyPercent": { "type": "number", "minimum": 0, "maximum": 100 } } },
    "trends": { "type": "object", "additionalProperties": false, "required": ["member", "building"], "properties": { "member": { "$ref": "#/$defs/memberTrend" }, "building": { "$ref": "#/$defs/buildingTrend" } } },
    "memberTrend": { "type": "object", "additionalProperties": false, "required": ["granularity", "unit", "points"], "properties": { "granularity": { "enum": ["hour", "day", "week"] }, "unit": { "const": "kWh" }, "points": { "type": "array", "items": { "$ref": "#/$defs/memberPoint" } } } },
    "buildingTrend": { "type": "object", "additionalProperties": false, "required": ["granularity", "unit", "points"], "properties": { "granularity": { "enum": ["hour", "day", "week"] }, "unit": { "const": "kWh" }, "points": { "type": "array", "items": { "$ref": "#/$defs/buildingPoint" } } } },
    "memberPoint": { "type": "object", "additionalProperties": false, "required": ["timestamp", "intervalCount", "consumptionKwh", "localEnergyKwh", "gridImportKwh"], "properties": { "timestamp": { "type": "string", "format": "date-time" }, "intervalCount": { "$ref": "#/$defs/positive" }, "consumptionKwh": { "$ref": "#/$defs/nonNegative" }, "localEnergyKwh": { "$ref": "#/$defs/nonNegative" }, "gridImportKwh": { "$ref": "#/$defs/nonNegative" } } },
    "buildingPoint": { "type": "object", "additionalProperties": false, "required": ["timestamp", "intervalCount", "consumptionKwh", "generationKwh", "localEnergyKwh", "gridImportKwh", "gridExportKwh"], "properties": { "timestamp": { "type": "string", "format": "date-time" }, "intervalCount": { "$ref": "#/$defs/positive" }, "consumptionKwh": { "$ref": "#/$defs/nonNegative" }, "generationKwh": { "$ref": "#/$defs/nonNegative" }, "localEnergyKwh": { "$ref": "#/$defs/nonNegative" }, "gridImportKwh": { "$ref": "#/$defs/nonNegative" }, "gridExportKwh": { "$ref": "#/$defs/nonNegative" } } },
    "nonNegative": { "type": "number", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 }
  }
}
