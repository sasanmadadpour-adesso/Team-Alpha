# Hosted Ruhende synchronization (copy to .env and add the real key locally)
REGISTERED_API_URL=https://ruhend.sidely.dev/api/v1/maloOverview()
REGISTERED_FALLBACK_API_URL=
# Optional detailed-data overrides; defaults are derived from the hosted origin.
HOUSE_MEMBER_PORTAL_API_URL=https://ruhend.sidely.dev/api/v1/house-member-portal
RUHENDE_DATA_API_URL=https://ruhend.sidely.dev/odata/v4/data
EXTERNAL_API_KEY=
# White-label member portal uses the same hosted service and key by default.
RUHEND_API_BASE_URL=https://ruhend.sidely.dev
RUHEND_API_TOKEN=
WHITE_LABEL_ONLY=false
