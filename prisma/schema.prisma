generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  RECEIVED
  VALIDATING
  VALIDATION_FAILED
  VERIFICATION_IN_PROGRESS
  SOURCE_UNAVAILABLE
  VERIFIED
  MANUAL_REVIEW
  REJECTED
}

enum Decision {
  VERIFIED
  MANUAL_REVIEW
  REJECTED
  VALIDATION_FAILED
  SOURCE_UNAVAILABLE
}

model VerificationRequest {
  id                     String             @id @default(uuid()) @db.Uuid
  idempotencyKey         String             @unique
  payloadHash            String
  schemaVersion          String
  rawPayload             Json
  normalizedPayload      Json
  status                 VerificationStatus
  decision               Decision?
  receivedAt             DateTime           @default(now())
  validationCompletedAt  DateTime?
  verificationCompletedAt DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  findings               ValidationFinding[]
  checks                 VerificationCheck[]
  attempts               IntegrationAttempt[]
}

model ValidationFinding {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @db.Uuid
  ruleId                String
  severity              String
  field                 String?
  submittedValue        Json?
  normalizedValue       Json?
  message               String
  details               Json?
  createdAt             DateTime            @default(now())
  request               VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  @@index([verificationRequestId])
}

model VerificationCheck {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @db.Uuid
  ruleId                String
  field                 String?
  result                String
  severity              String
  submittedValue        Json?
  authoritativeValue    Json?
  sourceSystem          String?
  sourceRecordId        String?
  effectiveAt           DateTime?
  checkedAt             DateTime            @default(now())
  details               Json?
  request               VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  @@index([verificationRequestId])
}

model IntegrationAttempt {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @db.Uuid
  provider              String
  operation             String
  attemptNumber         Int
  correlationId         String
  status                String
  startedAt             DateTime
  completedAt           DateTime?
  httpStatus            Int?
  errorCode             String?
  errorMessage          String?
  requestMetadata       Json?
  responseMetadata      Json?
  request               VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  @@index([verificationRequestId])
}
